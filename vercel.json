{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/api_app",
      "dest": "api/api_app.php"
    },
    {
      "src": "/api_coupon",
      "dest": "api/api_coupon.php"
    },
    {
      "src": "/api_load_products",
      "dest": "api/api_load_products.php"
    },
    {
      "src": "/api_locations",
      "dest": "api/api_locations.php"
    },
    {
      "src": "/(index|about|shop)",
      "dest": "api/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}
